<resources>
    <style name="Theme.MSN" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="colorPrimary">#FF4A90D9</item>
        <item name="colorPrimaryDark">#FF2E6CB0</item>
        <item name="colorAccent">#FF0088E4</item>
        <item name="android:windowBackground">@drawable/bg_wlm_frame</item>
    </style>
    <style name="WlmLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">#FF333333</item>
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:layout_marginBottom">2dp</item>
    </style>
    <style name="WlmField">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/bg_field</item>
        <item name="android:textColor">#FF000000</item>
        <item name="android:textSize">14sp</item>
        <item name="android:singleLine">true</item>
        <item name="android:layout_marginBottom">8dp</item>
    </style>
    <style name="WlmCheck">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">#FF001563</item>
        <item name="android:textSize">13sp</item>
        <item name="android:minHeight">32dp</item>
    </style>
    <style name="WlmPushButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minWidth">96dp</item>
        <item name="android:minHeight">32dp</item>
        <item name="android:background">@drawable/bg_pushbutton</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">#FF000000</item>
        <item name="android:textSize">14sp</item>
    </style>
    <style name="WlmLink">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">#FF0088E4</item>
        <item name="android:textSize">13sp</item>
        <item name="android:paddingTop">3dp</item>
        <item name="android:paddingBottom">3dp</item>
        <item name="android:clickable">true</item>
    </style>
</resources>
