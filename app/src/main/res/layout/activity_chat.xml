<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/chatRoot" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@drawable/bg_wlm_frame">
    <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_wlm_header">
        <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/swirl_header" android:tag="asset:swirl_header" android:scaleType="centerCrop" android:alpha="0.7" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"
            android:gravity="center_vertical" android:padding="6dp">
            <TextView android:id="@+id/btnBack" style="@style/WlmLink" android:text="\u25C0" android:textSize="18sp" android:paddingRight="8dp" android:paddingLeft="4dp" />
            <ImageView android:id="@+id/ivTitlePresence" android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/presence_online" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingStart="6dp">
                <TextView android:id="@+id/tvChatTitle" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:textColor="#FF000000" android:textSize="14sp" android:textStyle="bold" android:singleLine="true" android:ellipsize="end" />
                <TextView android:id="@+id/tvChatSub" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:textColor="#FF63614E" android:textSize="12sp" android:singleLine="true" android:ellipsize="end" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
    <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_toolbar" android:scrollbars="none">
        <LinearLayout android:id="@+id/toolbar" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:padding="2dp" />
    </HorizontalScrollView>
    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#FF9DB8D9" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:padding="6dp">
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/tvTo" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="#FF333333" android:textSize="12sp" android:paddingBottom="3dp" android:singleLine="true" android:ellipsize="end" />
            <ListView android:id="@+id/listMessages" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
                android:background="@drawable/bg_history" android:divider="@null" android:listSelector="@android:color/transparent"
                android:transcriptMode="alwaysScroll" android:stackFromBottom="true" android:padding="2dp" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"
                android:gravity="center_vertical" android:paddingTop="4dp" android:paddingBottom="2dp">
                <TextView android:id="@+id/btnEmo" style="@style/WlmLink" android:text="▾" android:drawableLeft="@drawable/ic_emoticon" android:drawablePadding="2dp" android:textSize="16sp" android:textColor="#FF000000" android:paddingRight="10dp" />
                <TextView android:id="@+id/btnWink" style="@style/WlmLink" android:textColor="#FF000000" android:text="▾" android:drawableLeft="@drawable/ic_wink" android:drawablePadding="2dp" android:textSize="14sp" android:paddingRight="10dp" />
                <TextView android:id="@+id/btnNudge" style="@style/WlmLink" android:textColor="#FF000000" android:text="@string/nudge" android:drawableLeft="@drawable/ic_nudge" android:drawablePadding="3dp" android:gravity="center_vertical" android:textSize="13sp" android:paddingRight="10dp" />
                <TextView android:id="@+id/btnFont" style="@style/WlmLink" android:textColor="#FF000000" android:text="\u25BE" android:drawableLeft="@drawable/ic_font" android:drawablePadding="2dp" android:textSize="14sp" android:paddingRight="10dp" />
                <TextView android:id="@+id/btnVoice" style="@style/WlmLink" android:textColor="#FF000000" android:text="@string/voice_clip" android:drawableLeft="@drawable/ic_voiceclip" android:drawablePadding="3dp" android:gravity="center_vertical" android:textSize="13sp" android:paddingRight="10dp" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                <EditText android:id="@+id/etMessage" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:background="@drawable/bg_history" android:padding="6dp" android:minLines="3" android:maxLines="4" android:gravity="top"
                    android:textSize="14sp" android:inputType="textMultiLine|textCapSentences" />
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginStart="5dp">
                    <Button android:id="@+id/btnSend" style="@style/WlmPushButton" android:minWidth="64dp" android:text="@string/send" />
                    <Button android:id="@+id/btnSearch" style="@style/WlmPushButton" android:minWidth="64dp" android:layout_marginTop="4dp" android:text="@string/search" android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:layout_width="wrap_content" android:layout_height="match_parent" android:orientation="vertical" android:paddingStart="6dp">
            <FrameLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/bg_tile_frame">
                <ImageView android:id="@+id/ivTheirTile" android:layout_width="64dp" android:layout_height="64dp" android:src="@drawable/tile_default" android:tag="asset:tile_default" />
            </FrameLayout>
            <View android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1" />
            <FrameLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/bg_tile_frame">
                <ImageView android:id="@+id/ivMyTileChat" android:layout_width="64dp" android:layout_height="64dp" android:src="@drawable/pic_duck" android:tag="asset:pic_duck" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
    <TextView android:id="@+id/tvTyping" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="#FFEAF3FB"
        android:paddingLeft="8dp" android:paddingTop="3dp" android:paddingBottom="3dp" android:textColor="#FF63614E" android:textSize="11sp" android:text=" " />
</LinearLayout>
