<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true"><shape>
        <gradient android:angle="270" android:startColor="#FFC4E2F7" android:endColor="#FF98C8EE" />
        <stroke android:width="1dp" android:color="#FF3C7FB1" /><corners android:radius="3dp" />
        <padding android:left="14dp" android:top="4dp" android:right="14dp" android:bottom="4dp" /></shape></item>
    <item><shape>
        <gradient android:angle="270" android:startColor="#FFFDFDFD" android:centerColor="#FFEBEBEB" android:endColor="#FFDDDDDD" />
        <stroke android:width="1dp" android:color="#FF707070" /><corners android:radius="3dp" />
        <padding android:left="14dp" android:top="4dp" android:right="14dp" android:bottom="4dp" /></shape></item>
</selector>
